{
  "opencollection": "1.0.0",
  "info": {
    "name": "Alleva Rest Data Facet API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "DataFacet",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "POST /data-facets/search",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.helloalleva.com/data-facets/search",
            "headers": [
              {
                "name": "X-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "api-version",
                "value": "",
                "type": "query"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "POST /v{version}/data-facets/search",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.helloalleva.com/v:version/data-facets/search",
            "headers": [
              {
                "name": "X-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path"
              },
              {
                "name": "api-version",
                "value": "",
                "type": "query"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}