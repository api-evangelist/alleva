{
  "opencollection": "1.0.0",
  "info": {
    "name": "Alleva Rest Sessions API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Sessions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /sessions/{id}",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.helloalleva.com/sessions/:id",
            "headers": [
              {
                "name": "X-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "expand",
                "value": "",
                "type": "query"
              },
              {
                "name": "api-version",
                "value": "",
                "type": "query"
              }
            ]
          }
        },
        {
          "info": {
            "name": "PUT /sessions/{id}",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.helloalleva.com/sessions/:id",
            "headers": [
              {
                "name": "X-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "api-version",
                "value": "",
                "type": "query"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}