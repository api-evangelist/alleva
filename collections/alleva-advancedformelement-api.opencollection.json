{
  "opencollection": "1.0.0",
  "info": {
    "name": "Alleva Rest Advanced Form Element API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "AdvancedFormElement",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /advanced-form-elements",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.helloalleva.com/advanced-form-elements",
            "headers": [
              {
                "name": "X-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "advancedFormId",
                "value": "",
                "type": "query"
              },
              {
                "name": "api-version",
                "value": "",
                "type": "query"
              }
            ]
          }
        },
        {
          "info": {
            "name": "GET /v{version}/advanced-form-elements",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.helloalleva.com/v:version/advanced-form-elements",
            "headers": [
              {
                "name": "X-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "advancedFormId",
                "value": "",
                "type": "query"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              },
              {
                "name": "api-version",
                "value": "",
                "type": "query"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}